{
  "name": "IBANOCHE sitio + CRM (demo)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "containerEnv": {
    "NODE_ENV": "production",
    "ALLOWED_ORIGINS": "*.app.github.dev,localhost:3000"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "IBANOCHE (sitio y /crm)", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["Prisma.prisma", "bradlc.vscode-tailwindcss", "dbaeumer.vscode-eslint"] }
  }
}
