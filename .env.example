# Conexión a PostgreSQL (DATABASE_URL puede ser la del pooler; DATABASE_URL_UNPOOLED es la directa, para migraciones)
DATABASE_URL="postgresql://ibanoche:ibanoche_dev@localhost:5432/ibanoche_crm?schema=public"
DATABASE_URL_UNPOOLED="postgresql://ibanoche:ibanoche_dev@localhost:5432/ibanoche_crm?schema=public"


# Duración de la sesión en horas
SESSION_TTL_HOURS=8

# Zona horaria de operación del laboratorio
APP_TIMEZONE="America/Mexico_City"

# Marca el entorno como demostración (muestra el aviso en la interfaz)
NEXT_PUBLIC_DEMO_MODE="true"

# Llave fija para la API de Emilia en la demo (opcional; si falta, el seed genera una)
EMILIA_DEMO_API_KEY="ibn_demo_cambia-esta-llave"
